#version 450

// Debug view colours: reads the raw values debugview.frag wrote and maps them per view.
// The colour scales match the legend in the Debug View window (debugviewwindow.cpp).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D values;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D colorOut;

layout(push_constant) uniform Push {
    uvec2 size;
    uint mode;           // DebugView
    float overdrawMax;   // count shown at the top of the heat scale
    uint streamingRoots; // states written for the streaming view
} push;

// Per streaming root slot, its state (StreamingRootState in debugview.h, plus 16 when it breaks the authoring contract).
layout(std430, set = 0, binding = 2) readonly buffer StreamingStates {
    uint data[];
} streamingStates;

// The lit image, which the streaming view lays its colours over (bound only in that view; another view's set holds the values again).
layout(set = 0, binding = 3) uniform sampler2D lit;

const uint viewWireframe = 1;
const uint viewTriangleSize = 2;
const uint viewOverdraw = 3;
const uint viewUv = 8;
const uint viewStreaming = 9;

const vec3 background = vec3(0.02);
// How strongly the streaming view's colours cover the lit image.
const float layerOpacity = 0.5;

// Blue, cyan, green, yellow, red over t in [0, 1] (the "jet" scale).
vec3 heat(float t) {
    t = clamp(t, 0.0, 1.0);
    float r = clamp(1.5 - abs(4.0 * t - 3.0), 0.0, 1.0);
    float g = clamp(1.5 - abs(4.0 * t - 2.0), 0.0, 1.0);
    float b = clamp(1.5 - abs(4.0 * t - 1.0), 0.0, 1.0);
    return vec3(r, g, b);
}

// The streaming view's colours, as the Streaming window's legend (streamingStateColor): no root grey, drawn as selected green, prefetched
// teal, requested blue, refused by a budget violet, late orange, a hole red. A root breaking the authoring contract is striped yellow.
vec3 streamingColor(uint slot, uvec2 pixel) {
    if (slot == 0u || slot > push.streamingRoots) {
        return vec3(0.35);
    }
    uint state = streamingStates.data[slot - 1u];
    const vec3 colors[7] = vec3[7](vec3(0.35), vec3(0.30, 0.75, 0.35), vec3(0.20, 0.70, 0.70), vec3(0.30, 0.45, 0.95), vec3(0.60, 0.40, 0.85), vec3(0.95, 0.60, 0.15),
                                   vec3(0.90, 0.20, 0.20));
    vec3 color = colors[min(state & 15u, 6u)];
    if ((state & 16u) != 0u && ((pixel.x + pixel.y) / 6u) % 2u == 0u) {
        color = mix(color, vec3(1.0, 0.9, 0.2), 0.6);
    }
    return color;
}

// A stable, well-spread colour per integer ID.
vec3 idColor(uint id) {
    uint h = id * 747796405u + 2891336453u;
    h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    h = (h >> 22u) ^ h;
    return vec3(float(h & 0xFFu), float((h >> 8u) & 0xFFu), float((h >> 16u) & 0xFFu)) / 255.0 * 0.85 + 0.15;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= push.size.x || pixel.y >= push.size.y) {
        return;
    }
    vec4 v = texelFetch(values, ivec2(pixel), 0);
    vec3 color = background;
    if (push.mode == viewStreaming) {
        color = texelFetch(lit, ivec2(pixel), 0).rgb;
    }
    if (v.a > 0.0) {
        if (push.mode == viewWireframe) {
            float line = 1.0 - smoothstep(0.5, 1.5, v.r);
            color = mix(vec3(v.g * 0.6), vec3(1.0, 0.75, 0.1), line);
        } else if (push.mode == viewTriangleSize) {
            // Area on a log scale: 1 pixel and under red, 1,000 pixels and up blue.
            color = heat(1.0 - clamp(log2(max(v.r, 1e-3)) / log2(1000.0), 0.0, 1.0));
        } else if (push.mode == viewOverdraw) {
            color = heat(v.r / push.overdrawMax);
        } else if (push.mode == viewUv) {
            vec2 uv = fract(v.rg);
            bool odd = (int(floor(v.r * 8.0)) + int(floor(v.g * 8.0))) % 2 != 0;
            color = vec3(uv, 0.2) * (odd ? 0.55 : 1.0);
        } else if (push.mode == viewStreaming) {
            color = mix(color, streamingColor(uint(v.r), pixel), layerOpacity);
        } else {
            color = idColor(uint(v.r));
        }
    }
    imageStore(colorOut, ivec2(pixel), vec4(color, 1.0));
}
