#usda 1.0
(
    doc = "The three cubes with cameras to fly through: a test scene for view.camera.fly, the Camera window's flight and the watch page's."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [
        @./three_cubes.usda@
    ]
)

def Xform "cameras"
{
    def Camera "flight_00"
    {
        float3 xformOp:rotateXYZ = (-20, 60, 0)
        double3 xformOp:translate = (18, 8, 4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "flight_01"
    {
        float3 xformOp:rotateXYZ = (-20, -45, 0)
        double3 xformOp:translate = (-12, 8, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "flight_02"
    {
        float3 xformOp:rotateXYZ = (-20, 180, 0)
        double3 xformOp:translate = (2, 8, -26)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
