#usda 1.0
(
    defaultPrim = "Tree"
)

def Xform "Tree"
{
    def Cone "Crown"
    {
        double radius = 0.8
        double height = 2
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.1, 0.5, 0.15)]
        double3 xformOp:translate = (0, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Trunk"
    {
        double radius = 0.15
        double height = 1
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.45, 0.3, 0.15)]
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
