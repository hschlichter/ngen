#usda 1.0
(
    defaultPrim = "RockGeom"
)

# The rock's levels, both in one file: a sphere for the fine level, a cube for the coarse one.
def Scope "RockGeom"
{
    def Xform "fine"
    {
        def Sphere "Stone"
        {
            double radius = 0.6
            color3f[] primvars:displayColor = [(0.55, 0.52, 0.5)]
            double3 xformOp:translate = (0, 0.6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "coarse"
    {
        def Cube "Stone"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.4, 0.38, 0.36)]
            double3 xformOp:translate = (0, 0.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
