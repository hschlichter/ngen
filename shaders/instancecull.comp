#version 450

// GPU instance culling with ordered compaction (src/renderer/README.md, "GPU-driven frame"),
// in three dispatches selected by push.mode:
//
//   0 cull     one thread per instance: frustum test against every view, visibility bits,
//              per-workgroup counters (draws and primitives per region, culling stats)
//   1 scan     one workgroup: per-region exclusive prefix over the workgroup counters gives
//              each workgroup's start offset; totals become the draw counts and stats
//   2 scatter  one thread per instance: in-workgroup prefix per region, command written at
//              the workgroup's offset plus the local prefix
//
// Commands keep instance order within a region, so output is deterministic.
//
// Regions: view * 4 + bucket; view 0 is the camera, views 1.. the shadow cascades; bucket bit 0
// is double-sided, bit 1 cutout. Camera regions hold every instance whose mesh is in the pool
// (submesh range). Cascade regions hold primFirst instances (whole mesh), except for a prim with a
// cutout submesh: its instances draw one by one (submesh range), so the cutout one is cut.
//
// Render LOD: an instance of a render-LOD group is drawn only when the group draws its level (lodselect.comp ran before); one whose mesh
// isn't in the pool marks its level in the group's residency mask, which the next frame's selection reads.

layout(local_size_x = 256) in;

const uint maxViews = 5;
const uint bucketCount = 4;
const uint regionCount = maxViews * bucketCount;
// Counter layout per workgroup and in the totals.
const uint counterDraws = 0;                              // regionCount: draws per region
const uint counterPrimitives = regionCount;               // regionCount: primitives per region
const uint counterCameraCulled = regionCount * 2;         // 1: camera-culled instances (all)
const uint counterCascadeCulled = counterCameraCulled + 1; // 4: culled primFirst instances per cascade
const uint counterCascadeDrawn = counterCascadeCulled + 4; // 4: visible primFirst instances per cascade
const uint counterLodDropped = counterCascadeDrawn + 4;    // 1: instances of a level their group doesn't draw
const uint counterCount = counterLodDropped + 1;

const uint flagPrimFirst = 1u << 0;
const uint flagDoubleSided = 1u << 1;
const uint flagBoundsValid = 1u << 2;
const uint flagCutout = 1u << 3;
const uint flagPrimHasCutout = 1u << 4;

layout(push_constant) uniform Push {
    uint mode;
} push;

layout(std430, set = 0, binding = 0) readonly buffer Params {
    uint instanceCount;
    uint viewCount;
    uint cullEnabled;
    uint commandCapacity;
    uint groupCount;
    uint commandsUsed; // the end of the last region
    uint pad0;
    uint pad1;
    // Each region's first command: the regions are packed one after another, each as large as the instances the CPU counted in its
    // bucket (DrawLists::countInstance), so a region's end is the next one's start.
    uint regionOffsets[regionCount];
    vec4 planes[maxViews * 6]; // normalized, from Frustum::fromViewProj on the CPU
} params;

struct Instance {
    mat4 model;
    uint material;
    uint mesh;
    uint indexOffset;
    uint indexCount;
    vec3 boundsMin;
    uint flags;
    vec3 boundsMax;
    uint lodLevel; // the instance's level + 1 in its group
    uint lodGroup; // its render-LOD group + 1, 0 for none
    uint pad1;
    uint pad2;
    uint pad3;
};
layout(std430, set = 0, binding = 1) readonly buffer Instances {
    Instance data[];
} instances;

struct MeshEntry {
    uint firstIndex;
    int vertexOffset;
    uint indexCount;
    uint pad;
};
layout(std430, set = 0, binding = 2) readonly buffer Meshes {
    MeshEntry data[];
} meshes;

layout(std430, set = 0, binding = 3) buffer Visibility {
    uint bits[]; // bit v: visible in view v
} visibility;

layout(std430, set = 0, binding = 4) buffer GroupCounters {
    uint data[]; // groupCount * counterCount
} groupCounters;

layout(std430, set = 0, binding = 5) buffer GroupOffsets {
    uint data[]; // groupCount * regionCount
} groupOffsets;

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 6) writeonly buffer Commands {
    DrawCommand data[]; // the regions, packed at params.regionOffsets
} commands;

layout(std430, set = 0, binding = 7) buffer Totals {
    uint data[]; // counterCount; the first regionCount are the indirect draw counts
} totals;

// Why each instance was culled, 4 bits per view: 0..5 the frustum plane that rejected it
// (left, right, bottom, top, near, far), 0xD a LOD level its group doesn't draw, 0xE visible, 0xF not tested (culling off or no
// bounds).
const uint planeVisible = 0xEu;
const uint planeNotTested = 0xFu;
const uint planeLevelNotDrawn = 0xDu; // a render-LOD level its group doesn't draw, in every view
layout(std430, set = 0, binding = 8) writeonly buffer CullPlanes {
    uint codes[];
} cullPlanes;

// Per render-LOD group (lodselect.comp): x its serial, y the level wanted (bits 0-7) and drawn (bits 8-15).
layout(std430, set = 0, binding = 9) readonly buffer LodStates {
    uvec2 data[];
} lodStates;

// Per render-LOD group, a bit per level with an instance whose mesh isn't in the pool.
layout(std430, set = 0, binding = 10) buffer LodResidency {
    uint bits[];
} lodResidency;

shared uint sharedCounters[counterCount];
shared uint scanData[256];

// Same test as Frustum::contains: the box corner furthest along each plane normal must not
// be behind the plane. Evaluated in the CPU's order, without contraction. Returns the index of
// the plane that rejects the box, or planeVisible.
uint rejectingPlane(Instance inst, uint view) {
    for (uint p = 0; p < 6; p++) {
        vec4 plane = params.planes[view * 6 + p];
        vec3 positive = vec3(plane.x >= 0.0 ? inst.boundsMax.x : inst.boundsMin.x,
                             plane.y >= 0.0 ? inst.boundsMax.y : inst.boundsMin.y,
                             plane.z >= 0.0 ? inst.boundsMax.z : inst.boundsMin.z);
        precise float d = plane.x * positive.x;
        d = d + plane.y * positive.y;
        d = d + plane.z * positive.z;
        d = d + plane.w;
        if (d < 0.0) {
            return p;
        }
    }
    return planeVisible;
}

MeshEntry meshOf(Instance inst) {
    if (inst.mesh >= uint(meshes.data.length())) {
        return MeshEntry(0u, 0, 0u, 0u);
    }
    return meshes.data[inst.mesh];
}

// Whether the instance draws its submesh range in view v; otherwise a cascade draws its whole mesh.
bool perSubmesh(Instance inst, uint view) {
    return view == 0 || (inst.flags & flagPrimHasCutout) != 0;
}

// The instance's bucket: cutout instances drawn per submesh go to the cutout buckets.
uint bucketOf(Instance inst, uint view) {
    uint bucket = (inst.flags & flagDoubleSided) != 0 ? 1u : 0u;
    if ((inst.flags & flagCutout) != 0 && perSubmesh(inst, view)) {
        bucket += 2u;
    }
    return bucket;
}

// Whether instance belongs to region r and is visible in its view.
bool drawnIn(Instance inst, MeshEntry mesh, uint bits, uint region) {
    uint view = region / bucketCount;
    uint bucket = region % bucketCount;
    if (view >= params.viewCount || mesh.indexCount == 0) {
        return false;
    }
    if (bucket != bucketOf(inst, view)) {
        return false;
    }
    if (!perSubmesh(inst, view) && (inst.flags & flagPrimFirst) == 0) {
        return false;
    }
    return (bits & (1u << view)) != 0;
}

void cull() {
    uint lid = gl_LocalInvocationID.x;
    uint m = gl_GlobalInvocationID.x;
    if (lid < counterCount) {
        sharedCounters[lid] = 0;
    }
    barrier();

    if (m < params.instanceCount) {
        Instance inst = instances.data[m];
        uint bits = 0;
        uint planes = 0;
        // An instance of a level its group doesn't draw is in no view; its mesh's residency is noted for the next selection.
        bool dropped = false;
        if (inst.lodGroup != 0 && inst.lodGroup <= uint(lodStates.data.length()) && inst.lodLevel != 0) {
            uint group = inst.lodGroup - 1;
            uint level = inst.lodLevel - 1;
            if (meshOf(inst).indexCount == 0) {
                atomicOr(lodResidency.bits[group], 1u << level);
            }
            dropped = ((lodStates.data[group].y >> 8) & 0xFFu) != level;
        }
        for (uint v = 0; v < params.viewCount && !dropped; v++) {
            uint code = planeNotTested;
            if (params.cullEnabled != 0 && (inst.flags & flagBoundsValid) != 0) {
                code = rejectingPlane(inst, v);
            }
            if (code >= planeVisible) {
                bits |= 1u << v;
            }
            planes |= code << (4 * v);
        }
        if (dropped) {
            for (uint v = 0; v < params.viewCount; v++) {
                planes |= planeLevelNotDrawn << (4 * v);
            }
            atomicAdd(sharedCounters[counterLodDropped], 1u);
        }
        visibility.bits[m] = bits;
        cullPlanes.codes[m] = planes;

        MeshEntry mesh = meshOf(inst);
        for (uint r = 0; r < regionCount; r++) {
            if (drawnIn(inst, mesh, bits, r)) {
                uint indexCount = perSubmesh(inst, r / bucketCount) ? inst.indexCount : mesh.indexCount;
                atomicAdd(sharedCounters[counterDraws + r], 1u);
                atomicAdd(sharedCounters[counterPrimitives + r], indexCount / 3);
            }
        }
        // Statistics: camera culling over every instance, cascade culling over primFirst
        // instances (the ones the shadow pass draws); a level not drawn counts as neither.
        if ((bits & 1u) == 0 && !dropped) {
            atomicAdd(sharedCounters[counterCameraCulled], 1u);
        }
        if ((inst.flags & flagPrimFirst) != 0 && !dropped) {
            for (uint c = 0; c + 1 < params.viewCount; c++) {
                if ((bits & (1u << (c + 1))) != 0) {
                    atomicAdd(sharedCounters[counterCascadeDrawn + c], 1u);
                } else {
                    atomicAdd(sharedCounters[counterCascadeCulled + c], 1u);
                }
            }
        }
    }
    barrier();

    if (lid < counterCount) {
        groupCounters.data[gl_WorkGroupID.x * counterCount + lid] = sharedCounters[lid];
    }
}

void scan() {
    // One thread per counter walks the workgroups in order; draw counters also record each
    // workgroup's start offset. Integer sums, so the result does not depend on scheduling.
    uint t = gl_LocalInvocationID.x;
    if (t >= counterCount) {
        return;
    }
    uint running = 0;
    for (uint g = 0; g < params.groupCount; g++) {
        uint value = groupCounters.data[g * counterCount + t];
        if (t < regionCount) {
            groupOffsets.data[g * regionCount + t] = running;
        }
        running += value;
    }
    totals.data[t] = running;
}

void scatter() {
    uint lid = gl_LocalInvocationID.x;
    uint m = gl_GlobalInvocationID.x;
    bool live = m < params.instanceCount;
    Instance inst;
    MeshEntry mesh = MeshEntry(0u, 0, 0u, 0u);
    uint bits = 0;
    if (live) {
        inst = instances.data[m];
        mesh = meshOf(inst);
        bits = visibility.bits[m];
    }

    for (uint r = 0; r < regionCount; r++) {
        uint member = (live && drawnIn(inst, mesh, bits, r)) ? 1u : 0u;
        // Inclusive Hillis-Steele scan across the workgroup.
        scanData[lid] = member;
        barrier();
        for (uint offset = 1; offset < 256; offset <<= 1) {
            uint add = lid >= offset ? scanData[lid - offset] : 0u;
            barrier();
            scanData[lid] += add;
            barrier();
        }
        uint regionEnd = r + 1 < regionCount ? params.regionOffsets[r + 1] : params.commandsUsed;
        if (member != 0) {
            uint slot = groupOffsets.data[gl_WorkGroupID.x * regionCount + r] + scanData[lid] - 1;
            bool submesh = perSubmesh(inst, r / bucketCount);
            DrawCommand command;
            command.indexCount = submesh ? inst.indexCount : mesh.indexCount;
            command.instanceCount = 1;
            command.firstIndex = submesh ? mesh.firstIndex + inst.indexOffset : mesh.firstIndex;
            command.vertexOffset = mesh.vertexOffset;
            command.firstInstance = m;
            // A command past the region's counted size would land in the next region (or past the buffer): never written.
            if (params.regionOffsets[r] + slot < regionEnd) {
                commands.data[params.regionOffsets[r] + slot] = command;
            }
        }
        barrier();
    }
}

void main() {
    if (push.mode == 0) {
        cull();
    } else if (push.mode == 1) {
        scan();
    } else {
        scatter();
    }
}
