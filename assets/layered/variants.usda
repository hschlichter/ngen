#usda 1.0
(
    doc = """An asset with variant sets, for the layered scene: geometry defined inside a variant, a set nested in a variant, and a set whose
    variants reference other files. Its own selections are the defaults a referencing layer overrides."""
    defaultPrim = "Lamp"
)

def Xform "Lamp" (
    kind = "component"
    variants = {
        string base = "tree"
        string shape = "cube"
    }
    prepend variantSets = ["shape", "base"]
)
{
    variantSet "shape" = {
        "cube" {
            def Cube "Geom"
            {
                double size = 0.6
                color3f[] primvars:displayColor = [(0.9, 0.8, 0.2)]
                double3 xformOp:translate = (0, 2.5, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
        "sphere" (
            variants = {
                string color = "red"
            }
            prepend variantSets = "color"
        ) {
            def Sphere "Geom"
            {
                double radius = 0.4
                double3 xformOp:translate = (0, 2.5, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            variantSet "color" = {
                "blue" {
                    over "Geom"
                    {
                        color3f[] primvars:displayColor = [(0.2, 0.3, 0.9)]
                    }
                }
                "red" {
                    over "Geom"
                    {
                        color3f[] primvars:displayColor = [(0.9, 0.2, 0.2)]
                    }
                }
            }
        }
    }
    variantSet "base" = {
        "house" {
            def "Base" (
                prepend references = @./building.usda@
            )
            {
            }
        }
        "tree" {
            def "Base" (
                prepend references = @./model.usda@
            )
            {
            }
        }
    }
}
