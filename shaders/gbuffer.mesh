#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

// The geometry pass: a pack of meshlets the task shader kept (meshlet.task), their vertices pulled from the pool, to gbuffer.frag or
// gbuffercutout.frag. The position expression is depth.mesh's, with gl_Position invariant in both, so the Equal test after the depth
// prepass matches exactly.

#define MESHLET_MESH_SHADER
#include "meshlet.glsl"

layout(push_constant) uniform Push {
    uint region;
    uint flags;
} push;

out gl_MeshPerVertexEXT {
    invariant vec4 gl_Position;
} gl_MeshVerticesEXT[];

layout(location = 0) out vec3 fragNormal[];
layout(location = 1) out vec3 fragColor[];
layout(location = 2) out vec2 fragTexCoord[];
// The texture slot of the primitive's instance. A pack can hold meshlets of several instances, so it varies within a draw and the
// fragment shaders index the texture array with nonuniformEXT.
layout(location = 3) flat out uint fragTexture[];
// The instance index + 1, for the id target picking reads; 0 is nothing drawn.
layout(location = 4) flat out uint fragInstance[];
// x: the drawn LOD level + 1 of the LOD root above it, 0 under none, with its group's flags (lodTag), and 128 per LOD root it is under
// (lodTagDepth, at most 15), for the LOD level view and the pop flash. y: the instance's share of a render-LOD fade as float bits
// (lodfade.glsl), for the cutout fragment shader; lodCoverAll when its group isn't fading. One output, so the opaque fragment shader, which
// reads only x, still takes it.
layout(location = 5) flat out uvec2 fragLod[];


// Per meshlet of the pack: its instance's model, texture slot and LOD output, loaded once.
shared mat4 packModels[meshletsPerTask];
shared uint packTextures[meshletsPerTask];
shared uvec2 packLods[meshletsPerTask];

void main() {
    uint pack = gl_WorkGroupID.x;
    uint vertexCount = payload.packVertices[pack];
    uint triangleCount = payload.packTriangles[pack];
    SetMeshOutputsEXT(vertexCount, triangleCount);
    // A pack of one meshlet loads its instance's values as uniform values; a pack of several, each meshlet's once by one lane, into shared
    // memory.
    PackInfo info = packInfo(pack);
    bool single = info.count == 1u;
    mat4 singleModel = mat4(1.0);
    uint singleTexture = 0u;
    uvec2 singleLod = uvec2(0u);
    if (single) {
        Instance inst = instances.data[payload.instances[info.first]];
        singleModel = inst.model;
        singleTexture = materials.data[inst.material].baseColorTexture;
        singleLod = uvec2(lodTag(inst.lodGroup, inst.lodLevel) + (min(inst.lodDepth, 15u) * lodTagDepth), floatBitsToUint(lodCoverage(inst.lodGroup, inst.lodLevel)));
    } else {
        loadPackShared(info);
        if (gl_LocalInvocationIndex < info.count) {
            Instance inst = instances.data[payload.instances[info.first + gl_LocalInvocationIndex]];
            packModels[gl_LocalInvocationIndex] = inst.model;
            packTextures[gl_LocalInvocationIndex] = materials.data[inst.material].baseColorTexture;
            packLods[gl_LocalInvocationIndex] = uvec2(lodTag(inst.lodGroup, inst.lodLevel) + (min(inst.lodDepth, 15u) * lodTagDepth), floatBitsToUint(lodCoverage(inst.lodGroup, inst.lodLevel)));
        }
        barrier();
    }
    uint v = gl_LocalInvocationIndex;
    if (v < vertexCount) {
        PackedVertex packed = packedVertex(info, v);
        uint vertex = packed.vertex;
        mat4 model = single ? singleModel : packModels[packed.meshlet];
        gl_MeshVerticesEXT[v].gl_Position = ubo.proj * ubo.view * model * vec4(poolPosition(vertex), 1.0);
        // Normalise here: the model matrix carries the scene's unit scale (Kitchen_set is authored in cm under a 0.01 root scale), which
        // would leave a near-zero normal for the fragment shader's zero guard to swallow.
        fragNormal[v] = normalize(mat3(model) * poolNormal(vertex));
        fragColor[v] = poolColor(vertex);
        fragTexCoord[v] = poolTexCoord(vertex);
        fragTexture[v] = single ? singleTexture : packTextures[packed.meshlet];
        fragInstance[v] = packed.instance + 1u;
        fragLod[v] = single ? singleLod : packLods[packed.meshlet];
    }
    for (uint t = v; t < triangleCount; t += packThreads) {
        gl_PrimitiveTriangleIndicesEXT[t] = packedTriangle(info, t);
    }
}
