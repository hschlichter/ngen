#usda 1.0
(
    defaultPrim = "Model"
)

def Xform "Model" (
    kind = "component"
)
{
    def Cylinder "Trunk"
    {
        double radius = 0.2
        double height = 1
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.45, 0.3, 0.15)]
        double3 xformOp:translate = (0, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Top"
    {
        point3f[] points = [(-0.6, 1, -0.6), (0.6, 1, -0.6), (0.6, 1, 0.6), (-0.6, 1, 0.6), (0, 2, 0)]
        int[] faceVertexCounts = [3, 3, 3, 3, 4]
        int[] faceVertexIndices = [0, 4, 1, 1, 4, 2, 2, 4, 3, 3, 4, 0, 0, 1, 2, 3]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.15, 0.55, 0.2)]
    }
}
