#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

// The shadow pass: a pack of meshlets the task shader kept, positions only, into the cascade the push constants name.

#define MESHLET_MESH_SHADER
#include "meshlet.glsl"

layout(push_constant) uniform Push {
    uint region;
    uint flags;
    uint pad0;
    uint pad1;
    mat4 lightViewProj;
} push;


// Per meshlet of the pack: its instance's model, loaded once.
shared mat4 packModels[meshletsPerTask];

void main() {
    uint pack = gl_WorkGroupID.x;
    uint vertexCount = payload.packVertices[pack];
    uint triangleCount = payload.packTriangles[pack];
    SetMeshOutputsEXT(vertexCount, triangleCount);
    // A pack of one meshlet (most packs of large meshlets) loads its model as a uniform value; a pack of several, each meshlet's model once
    // by one lane, into shared memory.
    PackInfo info = packInfo(pack);
    bool single = info.count == 1u;
    mat4 singleModel = mat4(1.0);
    if (single) {
        singleModel = instances.data[payload.instances[info.first]].model;
    } else {
        loadPackShared(info);
        if (gl_LocalInvocationIndex < info.count) {
            packModels[gl_LocalInvocationIndex] = instances.data[payload.instances[info.first + gl_LocalInvocationIndex]].model;
        }
        barrier();
    }
    uint v = gl_LocalInvocationIndex;
    if (v < vertexCount) {
        PackedVertex packed = packedVertex(info, v);
        mat4 model = single ? singleModel : packModels[packed.meshlet];
        gl_MeshVerticesEXT[v].gl_Position = push.lightViewProj * model * vec4(poolPosition(packed.vertex), 1.0);
    }
    for (uint t = v; t < triangleCount; t += packThreads) {
        gl_PrimitiveTriangleIndicesEXT[t] = packedTriangle(info, t);
    }
}
