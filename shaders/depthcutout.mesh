#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

// The depth prepass for cutout materials and render-LOD fades: depth.mesh's positions, and the texture coordinate, material and fade
// coverage cutout.frag tests with.

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

#include "meshlet.glsl"

layout(push_constant) uniform Push {
    uint region;
    uint flags;
} push;

out gl_MeshPerVertexEXT {
    invariant vec4 gl_Position;
} gl_MeshVerticesEXT[];

layout(location = 0) out vec2 fragTexCoord[];
layout(location = 1) flat out uint fragMaterial[];
layout(location = 2) flat out float fragLodCoverage[]; // its share of a render-LOD fade (lodfade.glsl)

void main() {
    MeshletDraw draw = meshletDraw(gl_WorkGroupID.x);
    Meshlet meshlet = draw.meshlet;
    uint vertexCount = meshletVertexCount(meshlet);
    uint triangleCount = meshletTriangleCount(meshlet);
    SetMeshOutputsEXT(vertexCount, triangleCount);
    Instance inst = instances.data[draw.instance];
    float coverage = lodCoverage(inst.lodGroup, inst.lodLevel);
    uint v = gl_LocalInvocationIndex;
    if (v < vertexCount) {
        uint vertex = meshletPoolVertex(meshlet, draw.vertexOffset, v);
        // From the culling camera, into a depth of its own, while it isn't the rendered one; otherwise gbuffer.mesh's expression.
        if ((push.flags & meshletFlagCullCamera) != 0u) {
            gl_MeshVerticesEXT[v].gl_Position = ubo.cullViewProj * inst.model * vec4(poolPosition(vertex), 1.0);
        } else {
            gl_MeshVerticesEXT[v].gl_Position = ubo.proj * ubo.view * inst.model * vec4(poolPosition(vertex), 1.0);
        }
        fragTexCoord[v] = poolTexCoord(vertex);
        fragMaterial[v] = inst.material;
        fragLodCoverage[v] = coverage;
    }
    for (uint t = v; t < triangleCount; t += 64u) {
        gl_PrimitiveTriangleIndicesEXT[t] = meshletTriangle(meshlet, t);
    }
}
